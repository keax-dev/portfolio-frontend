{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "api:types": "openapi-ts",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e && npm run build -- --configuration=production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:unit": "ng test --watch=false --exclude=src/**/*.integration.spec.ts",
    "test:unit:coverage": "ng test --watch=false --coverage --exclude=src/**/*.integration.spec.ts",
    "test:integration": "ng test --watch=false --include=src/**/*.integration.spec.ts",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --watch=false --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "lint": "ng lint",
    "typecheck": "npm run typecheck:app && npm run typecheck:tests && npm run typecheck:e2e",
    "typecheck:app": "ngc -p tsconfig.app.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.spec.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "dependencies": {
    "@angular/animations": "22.0.8",
    "@angular/cdk": "22.0.6",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/material": "22.0.6",
    "@angular/platform-browser": "22.0.8",
    "@angular/platform-server": "22.0.8",
    "@angular/router": "22.0.8",
    "@angular/ssr": "22.0.9",
    "bootstrap": "^5.3.8",
    "ngx-spinner": "^21.1.0",
    "primeicons": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.0.9",
    "@angular/cli": "22.0.9",
    "@angular/compiler-cli": "22.0.8",
    "@angular/platform-browser-dynamic": "22.0.8",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.97.3",
    "@playwright/test": "1.62.0",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "22.1.0",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@hey-api/json-schema-ref-parser": "1.4.1"
  }
}
